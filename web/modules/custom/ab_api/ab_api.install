<?php

/**
 * @file
 * Install and update hooks for the HTTP API.
 */

declare(strict_types=1);

use Drupal\ab_api\ApiSchema;

/**
 * Implements hook_schema().
 */
function ab_api_schema(): array {
  $schema['ab_idempotency'] = ApiSchema::idempotencyTable();
  $schema['ab_api_rate'] = ApiSchema::rateTable();
  return $schema;
}

/**
 * Installs the idempotency table on existing sites.
 */
function ab_api_update_11001(): string {
  return ApiSchema::install();
}

/**
 * Installs the shared rate table on existing sites.
 */
function ab_api_update_11002(): string {
  return ApiSchema::installRate();
}
