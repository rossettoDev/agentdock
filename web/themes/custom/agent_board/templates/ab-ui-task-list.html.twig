{#
/**
 * @file
 * Shows one board as fixed status columns.
 *
 * Cancelled tasks stay behind the filter. They are not a column.
 */
#}
{% macro card(card) %}
  <article class="ab-card{% if card.current %} is-current{% endif %}{% if card.targets or card.reorder_form %} ab-card--movable{% endif %}" data-uuid="{{ card.uuid }}"{% if card.targets or card.reorder_form %} draggable="true"{% endif %}{% if card.targets %} data-targets="{{ card.targets|join(' ') }}"{% endif %}>
    <h4 class="ab-card__title"><a href="{{ card.url }}"{% if card.current %} aria-current="page"{% endif %}>{{ card.label }}</a></h4>
    <p class="ab-card__meta">
      <span class="ab-badge{% if card.priority_key in ['low', 'normal', 'high', 'urgent'] %} ab-badge--{{ card.priority_key }}{% endif %}">{{ card.priority }}</span>
      {% if card.blocked %}
        <span class="ab-badge ab-badge--blocked">{{ 'Bloqueada'|t }}</span>
      {% endif %}
      {% if card.waiting %}
        <span class="ab-badge ab-badge--waiting_input">{{ 'Aguardando resposta'|t }}</span>
      {% endif %}
    </p>
    {% if card.due %}
      <p>{{ 'Prazo:'|t }} {{ card.due }}</p>
    {% endif %}
    {% if card.owner %}
      <p>{{ 'Responsável:'|t }} {{ card.owner }}</p>
    {% endif %}
    {% if card.agent_name %}
      <p class="ab-card__assignee"><span class="ab-avatar__mark" aria-hidden="true">{{ card.agent_name|first|upper }}</span>{{ card.agent_name }}</p>
    {% elseif card.agent %}
      <p>{{ 'Agente atribuído'|t }}</p>
    {% endif %}
    {% if card.attempt %}
      <p>{{ 'Tentativa'|t }} {{ card.attempt }}</p>
      <p>{{ card.execution }}</p>
    {% endif %}
    {% if card.move_form %}
      <details class="ab-card__move">
        <summary>{{ 'Mover'|t }}</summary>
        {{ card.move_form }}
      </details>
    {% endif %}
    {% if card.reorder_form %}
      {{ card.reorder_form }}
    {% endif %}
  </article>
{% endmacro %}
{% import _self as kanban %}
<div class="ab-task-list">
  <div class="ab-page-heading">
  {% if board_label %}
    <h2 class="ab-task-board">{{ board_label }}</h2>
  {% endif %}
  {% if board_description %}
    <p>{{ board_description }}</p>
  {% endif %}
  {% if archived %}
    <p>{{ 'Arquivado'|t }}</p>
  {% endif %}
  {% if archive_form %}
    {{ archive_form }}
  {% endif %}
  {% if add_url %}
    <p>
      <a class="ab-button use-ajax" data-dialog-type="modal" data-dialog-options='{"width":480}' href="{{ add_url }}">{{ 'Criar tarefa'|t }}</a>
    </p>
  {% endif %}
  </div>
  <nav class="ab-kanban-filters" aria-label="{{ 'Filtros do quadro'|t }}">
    {% if today_only or cancelled_only or priority or agent %}
      <a href="{{ board_url }}">{{ 'Voltar ao quadro'|t }}</a>
    {% endif %}
    <a href="{{ today_url }}"{% if today_only %} aria-current="page"{% endif %}>{{ 'Hoje'|t }}</a>
    <a href="{{ cancelled_url }}"{% if cancelled_only %} aria-current="page"{% endif %}>{{ 'Canceladas'|t }}</a>
    {% for item in priorities %}
      <a href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {% endfor %}
    {% for item in agents %}
      <a href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {% endfor %}
  </nav>
  <div class="ab-board-screen{% if panel %} has-panel{% endif %}">
  <div data-ab-sync="tasks" data-ab-sync-root>
  {% if cancelled_only %}
    <section class="ab-kanban-cancelled">
      <h3>{{ 'Canceladas'|t }}</h3>
      {% if cancelled is empty %}
        <p>{{ 'Nenhuma tarefa cancelada.'|t }}</p>
      {% else %}
        {% for card in cancelled %}
          {{ kanban.card(card) }}
        {% endfor %}
      {% endif %}
    </section>
  {% else %}
    {% if today_empty %}
      <p>{{ 'Nenhuma tarefa para hoje.'|t }}</p>
    {% elseif filter_empty %}
      <p>{{ 'Nenhuma tarefa com este filtro.'|t }}</p>
    {% elseif empty %}
      <p>{{ 'Nenhuma tarefa neste board.'|t }}</p>
    {% endif %}
    <div class="ab-kanban">
      {% for column in columns %}
        <section class="ab-kanban__column" data-status="{{ column.status }}">
          <h3>
            {{ column.label }}
            <span class="ab-kanban__count">{{ column.cards|length }}</span>
          </h3>
          <div class="ab-kanban__cards">
            {% for card in column.cards %}
              {{ kanban.card(card) }}
            {% endfor %}
          </div>
        </section>
      {% endfor %}
    </div>
  {% endif %}
  </div>
  {% if panel %}
    <aside class="ab-board-panel" aria-label="{{ 'Tarefa selecionada'|t }}">
      <p class="ab-board-panel__actions">
        <a href="{{ panel.close_url }}">{{ 'Fechar'|t }}</a>
        <a href="{{ panel.task_url }}">{{ 'Página da tarefa'|t }}</a>
      </p>
      <h3>{{ panel.label }}</h3>
      <p>{{ panel.status }}</p>
      <p>{{ panel.priority }}</p>
      {% if panel.owner %}
        <p>{{ 'Responsável:'|t }} {{ panel.owner }}</p>
      {% endif %}
      {% if panel.due %}
        <p>{{ 'Prazo:'|t }} {{ panel.due }}</p>
      {% endif %}
      {% if panel.description %}
        <div class="ab-board-panel__text">{{ panel.description }}</div>
      {% endif %}
      {% if panel.criteria %}
        <h4>{{ 'Critérios'|t }}</h4>
        <div class="ab-board-panel__text">{{ panel.criteria }}</div>
      {% endif %}
      <h4>{{ 'Discussão'|t }}</h4>
      {% if panel.messages %}
        <ol class="ab-messages">
          {% for message in panel.messages %}
            <li>
              <p>{{ message.author }} · {{ message.time }}</p>
              {{ message.body }}
            </li>
          {% endfor %}
        </ol>
      {% else %}
        <p>{{ panel.messages_empty }}</p>
      {% endif %}
      {% if panel.message_form %}
        {{ panel.message_form }}
      {% endif %}
    </aside>
  {% endif %}
  </div>
</div>
