<?php

/**
 * @file
 * Install and update hooks for agents and board grants.
 */

declare(strict_types=1);

use Drupal\ab_agent\AgentRuntimeAccount;
use Drupal\ab_agent\AgentSchemaInstaller;

/**
 * Implements hook_schema().
 *
 * The grant pair is an internal table. It is not a content entity.
 */
function ab_agent_schema(): array {
  $schema['ab_agent_board_grant'] = AgentSchemaInstaller::grantTable();
  $schema['ab_agent_token'] = AgentSchemaInstaller::tokenTable();
  return $schema;
}

/**
 * Creates the blocked account that bearer requests run as.
 */
function ab_agent_install(): void {
  AgentRuntimeAccount::ensure();
}

/**
 * Installs the agent entity and the grant table on existing sites.
 */
function ab_agent_update_11001(): string {
  return AgentSchemaInstaller::install();
}

/**
 * Installs hashed agent tokens and the blocked runtime account.
 */
function ab_agent_update_11002(): string {
  return AgentSchemaInstaller::installTokens();
}
