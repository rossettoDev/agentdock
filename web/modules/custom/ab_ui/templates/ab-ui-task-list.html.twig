{#
/**
 * @file
 * Shows one board as fixed status columns.
 *
 * Cancelled tasks stay behind the filter. They are not a column.
 */
#}
{% macro card(card) %}
  <article class="ab-card">
    <h4><a href="{{ card.url }}">{{ card.label }}</a></h4>
    <p>{{ card.priority }}</p>
    {% if card.due %}
      <p>{{ 'Prazo:'|t }} {{ card.due }}</p>
    {% endif %}
    {% if card.owner %}
      <p>{{ 'Responsável:'|t }} {{ card.owner }}</p>
    {% endif %}
    {% if card.agent %}
      <p>{{ 'Agente atribuído'|t }}</p>
    {% endif %}
    {% if card.blocked %}
      <p>{{ 'Bloqueada'|t }}</p>
    {% endif %}
  </article>
{% endmacro %}
{% import _self as kanban %}
<div class="ab-task-list">
  {% if board_label %}
    <p class="ab-task-board">{{ board_label }}</p>
  {% endif %}
  {% if add_url %}
    <p>
      <a class="ab-button" href="{{ add_url }}">{{ 'Criar tarefa'|t }}</a>
    </p>
  {% endif %}
  {% if cancelled_only %}
    <p><a href="{{ board_url }}">{{ 'Voltar ao quadro'|t }}</a></p>
    <section class="ab-kanban-cancelled">
      <h3>{{ 'Canceladas'|t }}</h3>
      {% if cancelled is empty %}
        <p>{{ 'Nenhuma tarefa cancelada.'|t }}</p>
      {% else %}
        {% for card in cancelled %}
          {{ kanban.card(card) }}
        {% endfor %}
      {% endif %}
    </section>
  {% else %}
    <p><a href="{{ cancelled_url }}">{{ 'Canceladas'|t }}</a></p>
    {% if empty %}
      <p>{{ 'Nenhuma tarefa neste board.'|t }}</p>
    {% endif %}
    <div class="ab-kanban">
      {% for column in columns %}
        <section class="ab-kanban__column">
          <h3>
            {{ column.label }}
            <span class="ab-kanban__count">{{ column.cards|length }}</span>
          </h3>
          {% for card in column.cards %}
            {{ kanban.card(card) }}
          {% endfor %}
        </section>
      {% endfor %}
    </div>
  {% endif %}
</div>
