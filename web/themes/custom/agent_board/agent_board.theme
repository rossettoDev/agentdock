<?php

/**
 * @file
 * Theme preprocess functions for wiki nodes.
 */

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function agent_board_preprocess_node__wiki(&$variables) {
  // Attach wiki library to wiki nodes.
  $variables['#attached']['library'][] = 'agent_board/wiki';
}

/**
 * Implements hook_preprocess_HOOK() for views templates.
 */
function agent_board_preprocess_views_view__wiki_docs(&$variables) {
  // Attach wiki library to wiki docs view.
  $variables['#attached']['library'][] = 'agent_board/wiki';
}
