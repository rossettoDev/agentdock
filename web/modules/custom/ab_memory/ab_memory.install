<?php

/**
 * @file
 * Install and update hooks for shared agent memory.
 */

declare(strict_types=1);

use Drupal\ab_memory\MemorySchema;
use Drupal\ab_memory\MemorySearchIndex;

/**
 * Implements hook_schema().
 */
function ab_memory_schema(): array {
  $schema['ab_memory_entry'] = MemorySchema::entryTable();
  $schema['ab_memory_revision'] = MemorySchema::revisionTable();
  $schema['ab_memory_source'] = MemorySchema::sourceTable();
  $schema['ab_memory_link'] = MemorySchema::linkTable();
  $schema['ab_memory_search_index'] = MemorySchema::searchIndexTable();
  return $schema;
}

/**
 * Implements hook_install().
 */
function ab_memory_install(): void {
  \Drupal::service(MemorySearchIndex::class)->ensureFts();
}

/**
 * Installs memory tables on sites that already have the module enabled.
 */
function ab_memory_update_11001(): string {
  return MemorySchema::install();
}

/**
 * Adds the lexical search projection and rebuilds it.
 */
function ab_memory_update_11002(): string {
  $created = MemorySchema::install();
  /** @var \Drupal\ab_memory\MemorySearchIndex $index */
  $index = \Drupal::service(MemorySearchIndex::class);
  $index->ensureFts();
  $count = $index->rebuild();
  return $created . ' Indexed ' . $count . ' memory rows.';
}
