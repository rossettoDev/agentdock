<?php

/**
 * @file
 * Install and update hooks for conversation threads.
 */

declare(strict_types=1);

use Drupal\ab_communication\CommunicationSchema;

/**
 * Implements hook_schema().
 */
function ab_communication_schema(): array {
  $schema['ab_thread'] = CommunicationSchema::threadTable();
  $schema['ab_message'] = CommunicationSchema::messageTable();
  $schema['ab_input_request'] = CommunicationSchema::inputTable();
  $schema['ab_message_mention'] = CommunicationSchema::mentionTable();
  $schema['ab_notification'] = CommunicationSchema::notificationTable();
  return $schema;
}

/**
 * Installs the thread and message tables on existing sites.
 */
function ab_communication_update_11001(): string {
  return CommunicationSchema::install();
}

/**
 * Installs the input request table on existing sites.
 */
function ab_communication_update_11002(): string {
  return CommunicationSchema::installInput();
}

/**
 * Installs mention and notification tables on existing sites.
 */
function ab_communication_update_11003(): string {
  return CommunicationSchema::installSignals();
}
