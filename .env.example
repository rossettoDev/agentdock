# AgentDock Environment Variables
#
# Copy this file to .env and configure with your values.
# DO NOT commit .env with secrets to version control.

# Database Configuration (PostgreSQL)
# For Lando local development, these are the default values.
# Lando uses: database=drupal11, user=postgres, password=(empty)
# For production, configure with actual credentials.
DB_HOST=database
DB_PORT=5432
DB_NAME=drupal11
DB_USER=postgres
DB_PASSWORD=

# Drupal Hash Salt
# CRITICAL: Generate a unique value for production!
# Command: drush eval "var_export(Drupal\Component\Utility\Crypt::randomBytesBase64(55))"
DRUPAL_HASH_SALT=temporary-hash-salt-change-in-production

# Deployment Identifier (optional)
# Used to invalidate caches on deployment
# DEPLOYMENT_ID=v1.0.0

# Trusted Host Patterns (production)
# Add your production domains to settings.php trusted_host_patterns
# Example: '^example\.com$', '^www\.example\.com$'
