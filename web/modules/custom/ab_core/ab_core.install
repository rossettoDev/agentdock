<?php

/**
 * @file
 * Install, update and uninstall functions for AgentDock core.
 */

use Drupal\ab_core\MembershipSchemaInstaller;
use Drupal\ab_core\PersonalWorkspaceSchema;
use Drupal\ab_core\WorkspaceSchemaInstaller;

/**
 * Installs the workspace entity schema.
 */
function ab_core_update_11001(): string {
  return WorkspaceSchemaInstaller::install();
}

/**
 * Installs the membership entity schema.
 */
function ab_core_update_11002(): string {
  return MembershipSchemaInstaller::install();
}

/**
 * Installs the personal workspace field and owner index.
 */
function ab_core_update_11003(): string {
  return PersonalWorkspaceSchema::install();
}
