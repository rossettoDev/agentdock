<?php

/**
 * @file
 * Module hooks for ab_documentation.
 */

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function ab_documentation_preprocess_node(&$variables) {
  $node = $variables['node'];
  if ($node->bundle() === 'wiki') {
    $variables['#attached']['library'][] = 'agent_board/wiki';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views templates.
 */
function ab_documentation_preprocess_views_view(&$variables) {
  $view = $variables['view'];
  if ($view->id() === 'wiki_docs') {
    $variables['#attached']['library'][] = 'agent_board/wiki';
  }
}
