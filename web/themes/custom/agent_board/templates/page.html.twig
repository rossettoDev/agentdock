{#
/**
 * @file
 * Dark application shell for the screens that already have routes.
 */
#}
<div class="ab-layout">
  {% if shell_nav %}
    <div class="ab-app">
      <aside id="ab-sidebar" class="ab-sidebar">
        <div class="ab-logo">
          <a href="{{ front_page }}"><span class="ab-logo__mark" aria-hidden="true">◈</span> {{ site_name|default('AgentDock') }}</a>
        </div>
        <nav class="ab-sidebar__nav" aria-label="{{ 'Principal'|t }}">
          <ul>
            {% for item in shell_nav %}
              <li>
                {% set icon = item.icon|default('board') %}
                <a href="{{ item.url }}"{% if item.active %} class="is-active" aria-current="page"{% endif %}>
                  <span class="ab-nav-icon" aria-hidden="true">{% include 'agent_board:ab-icon' with {name: icon} only %}</span>
                  {{ item.label }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </nav>
        {% if shell_boards %}
          <p class="ab-sidebar__label">{{ 'Boards'|t }}</p>
          <ul class="ab-sidebar__boards">
            {% for board in shell_boards %}
              <li>
                <a href="{{ board.url }}"{% if board.active %} class="is-active" aria-current="page"{% endif %}>{{ board.label }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
        {% if shell_add_board %}
          <p class="ab-sidebar__add">
            <a href="{{ shell_add_board }}">{{ 'Novo board'|t }}</a>
          </p>
        {% endif %}
        {% if shell_account %}
          <div class="ab-sidebar__foot">
            <a class="ab-profile" href="{{ shell_account_url }}">
              <span class="ab-avatar__mark" aria-hidden="true">{{ shell_account|first|upper }}</span>
              <span><strong>{{ shell_account }}</strong><small>{{ 'Minha conta'|t }}</small></span>
            </a>
          </div>
        {% endif %}
      </aside>

      <div class="ab-main">
        <header class="ab-header" role="banner">
          <div class="ab-header__inner">
            <button type="button" class="ab-button ab-button--quiet" data-ab-nav-toggle aria-expanded="true" aria-controls="ab-sidebar">{{ 'Menu'|t }}</button>
            <div class="ab-header__slot">
              {% if workspace_selector %}
                <div class="ab-workspace-selector">
                  {{ workspace_selector }}
                </div>
              {% endif %}
            </div>
            <div class="ab-header__actions">
              <button type="button" class="ab-button ab-button--quiet ab-bell" data-ab-bell aria-expanded="false" aria-controls="ab-context">
                {% include 'agent_board:ab-icon' with {name: 'bell'} only %}<span class="ab-visually-hidden">{{ 'Notificações'|t }}</span>
                {% if shell_unread %}
                  <span class="ab-bell__count">{{ shell_unread }}</span>
                {% endif %}
              </button>
              {% if shell_account %}
                <a class="ab-account" href="{{ shell_account_url }}">{{ shell_account }}</a>
              {% endif %}
            </div>
          </div>
        </header>
        {% if shell_breadcrumb %}
          {{ shell_breadcrumb }}
        {% endif %}
        <div class="ab-body">
          <main class="ab-content" role="main">
            <a id="main-content" tabindex="-1"></a>
            {{ page.content }}
          </main>
          <aside id="ab-context" class="ab-context" hidden>
            <button type="button" class="ab-button ab-button--quiet" data-ab-context-close>{{ 'Fechar'|t }}</button>
            <h2>{{ 'Notificações'|t }}</h2>
            {% if shell_notices.items %}
              <ul class="ab-context__list">
                {% for item in shell_notices.items %}
                  <li>{{ item.label }} — {{ item.read }}</li>
                {% endfor %}
              </ul>
            {% else %}
              <p>{{ shell_notices.empty }}</p>
            {% endif %}
            {% if notifications_url %}
              <p><a href="{{ notifications_url }}">{{ 'Ver todas'|t }}</a></p>
            {% endif %}
          </aside>
        </div>
      </div>
    </div>
  {% else %}
    <header class="ab-header" role="banner">
      <div class="ab-header__inner">
        <div class="ab-logo">
          <a href="{{ front_page }}"><span class="ab-logo__mark" aria-hidden="true">◈</span> {{ site_name|default('AgentDock') }}</a>
        </div>
      </div>
    </header>
    <div class="ab-main">
      <main class="ab-content" role="main">
        <a id="main-content" tabindex="-1"></a>
        {{ page.content }}
      </main>
    </div>
  {% endif %}
</div>
