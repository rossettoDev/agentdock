{#
/**
 * @file
 * Dark application shell for the screens that already have routes.
 */
#}
<div class="ab-layout">
  {% if shell_nav %}
    <div class="ab-app">
      <aside class="ab-sidebar">
        <div class="ab-logo">
          <a href="{{ front_page }}">{{ site_name|default('AgentDock') }}</a>
        </div>
        <nav class="ab-sidebar__nav" aria-label="{{ 'Principal'|t }}">
          <ul>
            {% for item in shell_nav %}
              <li>
                <a href="{{ item.url }}"{% if item.active %} class="is-active" aria-current="page"{% endif %}>{{ item.label }}</a>
              </li>
            {% endfor %}
          </ul>
        </nav>
        {% if shell_boards %}
          <p class="ab-sidebar__label">{{ 'Boards'|t }}</p>
          <ul class="ab-sidebar__boards">
            {% for board in shell_boards %}
              <li>
                <a href="{{ board.url }}"{% if board.active %} class="is-active" aria-current="page"{% endif %}>{{ board.label }}</a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
        {% if shell_add_board %}
          <p class="ab-sidebar__add">
            <a href="{{ shell_add_board }}">{{ 'Novo board'|t }}</a>
          </p>
        {% endif %}
      </aside>

      <div class="ab-main">
        <header class="ab-header" role="banner">
          <div class="ab-header__inner">
            {% if workspace_selector %}
              <div class="ab-workspace-selector">
                {{ workspace_selector }}
              </div>
            {% endif %}
            {% if shell_account %}
              <p class="ab-account">{{ shell_account }}</p>
            {% endif %}
          </div>
        </header>
        <main class="ab-content" role="main">
          <a id="main-content" tabindex="-1"></a>
          {{ page.content }}
        </main>
      </div>
    </div>
  {% else %}
    <header class="ab-header" role="banner">
      <div class="ab-header__inner">
        <div class="ab-logo">
          <a href="{{ front_page }}">{{ site_name|default('AgentDock') }}</a>
        </div>
      </div>
    </header>
    <div class="ab-main">
      <main class="ab-content" role="main">
        <a id="main-content" tabindex="-1"></a>
        {{ page.content }}
      </main>
    </div>
  {% endif %}
</div>
